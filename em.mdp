; Energy minimization of the Packmol structure

integrator      = steep
nsteps          = 50000
emtol           = 1000.0
emstep          = 0.01

cutoff-scheme   = Verlet
nstlist         = 20
rlist           = 1.2

coulombtype     = PME
rcoulomb        = 1.2

vdwtype         = Cut-off
rvdw            = 1.2
DispCorr        = EnerPres

constraints     = none
pbc             = xyz

; Preserve only the final minimized structure; do not write a coordinate,
; velocity, or force trajectory for this restartable preparation stage.
nstxout          = 0
nstvout          = 0
nstfout          = 0
nstenergy       = 100
nstlog          = 100
