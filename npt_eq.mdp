; 1 ns NPT equilibration

integrator              = md
dt                      = 0.00025
nsteps                  = 4000000
continuation            = yes

; Multiple-time-step integration: 0.25 fs inner, 2 fs outer
mts                     = yes
mts-levels              = 2
mts-level2-factor       = 8
mts-level2-forces       = nonbonded longrange-nonbonded

; Save thermodynamic diagnostics but not a redundant equilibration trajectory.
; The final GRO/CPT state is retained for production and reproducibility.
nstxout                  = 0
nstvout                  = 0
nstfout                  = 0
nstenergy                = 4000
nstlog                   = 4000
nstxout-compressed       = 0
nstcalcenergy           = 400

; Neighbor searching
cutoff-scheme           = Verlet
nstlist                 = 40
verlet-buffer-tolerance = 0.002
rlist                   = 1.2

; Electrostatics
coulombtype             = PME
rcoulomb                = 1.2
fourierspacing          = 0.12
pme_order               = 4

; van der Waals
vdwtype                 = Cut-off
rvdw                    = 1.2
DispCorr                = EnerPres

; Temperature: 298.15 K
tcoupl                  = Berendsen
tc-grps                 = System
tau_t                   = 5.0
ref_t                   = 298.15
nsttcouple              = 8

; Pressure: 1 atmosphere
pcoupl                  = Berendsen
pcoupltype              = isotropic
tau_p                   = 91.2
ref_p                   = 1.01325
compressibility         = 4.5e-5
nstpcouple              = 8

constraints             = none
pbc                     = xyz

gen_vel                 = no

comm-mode               = Linear
nstcomm                 = 800
